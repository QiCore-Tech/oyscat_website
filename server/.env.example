PORT=4000
# Bind to loopback: only the Next server (web/) should reach this service.
HOST=127.0.0.1
# Express "trust proxy" setting; loopback trusts the co-located Next server's X-Forwarded-For.
TRUST_PROXY=loopback

# SMTP over implicit TLS on 465 (STARTTLS on other ports). SMTP_USER is also the From address.
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_USER=
# Mailbox SMTP authorization code, not the login password.
SMTP_PASS=
SMTP_TIMEOUT_MS=10000

# Inbox that receives new-subscriber notices.
SUBSCRIBE_NOTIFY_EMAIL=
# Total notices allowed per minute across all visitors (per-IP limit is fixed at 1/min).
SUBSCRIBE_GLOBAL_MAX_PER_MINUTE=20

# Shared secret with the website (set the same value as the web project's OYSCAT_FORWARD_SECRET).
# When set, only the website can call this service, and the visitor address it forwards is used for rate limiting.
# Required when the website and this service are separate Vercel projects. Generate one with: openssl rand -hex 32
OYSCAT_FORWARD_SECRET=
