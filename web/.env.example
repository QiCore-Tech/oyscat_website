# Where the Next /api/subscribe route forwards to (the Express service in ../server).
OYSCAT_API_URL=http://127.0.0.1:4000
# Extra dev-server hosts, e.g. a LAN IP (comma-separated). Put real values in .env.development.local.
OYSCAT_DEV_ALLOWED_ORIGINS=
# Public origin of the site (e.g. https://www.example.com). Used for canonical, Open Graph, sitemap and
# structured-data URLs; without it they follow the request's host. Set it in production.
OYSCAT_SITE_URL=
